{
  "name": "vue-email",
  "version": "0.0.0-alpha",
  "description": "Vue Email components library, inspired by React Email. Build beautiful emails with Vue components.",
  "author": "Vue Email Team",
  "license": "MIT",
  "keywords": [
    "vue",
    "vue-email",
    "email",
    "email-template",
    "vue-components"
  ],
  "homepage": "https://github.com/RainHillGit/vue-email",
  "repository": {
    "type": "git",
    "url": "https://github.com/RainHillGit/vue-email"
  },
  "bugs": {
    "url": "https://github.com/RainHillGit/vue-email/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js",
      "require": "./dist/preview.cjs"
    },
    "./vite-plugin": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/vite-plugin.js",
      "require": "./dist/vite-plugin.cjs"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js",
      "require": "./dist/module.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx,.vue --fix",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.3.0",
    "@vue/server-renderer": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    },
    "resend": {
      "optional": true
    }
  },
  "dependencies": {
    "@vue/server-renderer": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/runtime-core": "^3.4.0",
    "eslint": "^8.56.0",
    "jsdom": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.2.0",
    "vue": "^3.4.0"
  }
}
